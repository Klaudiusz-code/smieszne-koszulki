# Backend WordPress + WPGraphQL
WORDPRESS_GRAPHQL_URL=https://zabawnekoszulki.pl/graphql
# Opcjonalne nadpisania dla instalacji niestandardowej; domyślnie wynikają z GraphQL.
WORDPRESS_BASE_URL=
WORDPRESS_REST_URL=

# Publiczny adres frontendu Next.js (zmień po wdrożeniu)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Dodatkowe originy frontendu rozdzielone przecinkami (bez ścieżek).
ALLOWED_ORIGINS=

# Opcjonalnie: ID formularza Contact Form 7
WORDPRESS_CONTACT_FORM_ID=

# Włącz dopiero po instalacji WPGraphQL JWT Authentication
NEXT_PUBLIC_ACCOUNT_FEATURES_ENABLED=false

# Opcjonalne integracje analityczne
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
