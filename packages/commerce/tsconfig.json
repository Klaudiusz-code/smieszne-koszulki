{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["react"]
  },
  "include": ["core/**/*.ts", "http/**/*.ts", "woocommerce/**/*.ts", "react/**/*.ts", "react/**/*.tsx"]
}
